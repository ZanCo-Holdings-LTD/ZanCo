# Copy to .env (worker) and apps/web/.env.local (web). Never commit either.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The app connects as `aggregatoriq_app`, a role that owns nothing — a table
# owner bypasses row-level security. The migrations create the roles; grant them
# a password out of band.
DATABASE_URL=postgres://aggregatoriq_app:password@localhost:5432/aggregatoriq
DATABASE_SSL=false

# Used only by `pnpm test:db`, which drops and recreates the public schema.
# Never point this at anything you care about.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/aggregatoriq_test

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=in.aggregatoriq.com

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
WORKER_URL=http://localhost:8080

# Authenticates web -> worker calls. The worker can write the canonical layer
# and reconcile across organisations; the web tier cannot. Generate with:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=

# Verifies Resend's signature on inbound email. Required in production: the
# endpoint accepts files from anyone who knows a customer's ingestion address.
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=in.aggregatoriq.com

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Original statements are kept forever — they are the evidence behind every
# dispute. `local` writes to disk and is development only; an ephemeral
# filesystem loses a customer's records.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Stripe for the UAE and elsewhere; Moyasar or Tap for Saudi, where mada is the
# card network that matters.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Extraction (the second rung of the parsing ladder)
# ---------------------------------------------------------------------------
# Off by default. With no key configured, unrecognised layouts fall back to the
# manual review queue rather than failing — turning this on is a deliberate act.
# A model may only locate which cell means what. It never computes a number.
EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5
