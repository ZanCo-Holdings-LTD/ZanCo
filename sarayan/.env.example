# Sarayan — environment configuration
#
# Copy to apps/web/.env.local for development, or set these as secrets in your
# deployment. Only DATABASE_URL is required: every integration below degrades to
# something that still works, so the app boots and is useful without any of them.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. Works with Neon, Supabase, RDS or a local instance.
DATABASE_URL=postgres://user:password@localhost:5432/sarayan

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Absolute origin. Used in alert emails, evidence-pack verify links and OG tags.
NEXT_PUBLIC_APP_URL=https://sarayan.app

# Signs cookies and one-time tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Wraps each tenant's data encryption key. 32 bytes, base64. Generate with:
#   openssl rand -base64 32
# Rotating this requires re-wrapping every tenant key — treat it as permanent.
MASTER_ENCRYPTION_KEY=

# Shared secret the scheduler presents to /api/cron/alerts.
#   openssl rand -hex 32
# Without it, the endpoint is refused in production and open in development.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Document extraction — without it, uploads still work and fields are typed
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Alert delivery — without it, alerts still appear in-app and are logged
# ---------------------------------------------------------------------------

RESEND_API_KEY=
EMAIL_FROM="Sarayan <alerts@sarayan.app>"

# WhatsApp through a BSP (360dialog, Unifonic). Business-initiated messages
# require an approved template — create it before enabling this.
WHATSAPP_PROVIDER=360dialog
WHATSAPP_API_KEY=
WHATSAPP_BASE_URL=https://waba-v2.360dialog.io
WHATSAPP_SENDER=
WHATSAPP_TEMPLATE_NAME=sarayan_expiry_alert

# ---------------------------------------------------------------------------
# Document storage — without it, files go to the local filesystem
# ---------------------------------------------------------------------------

# S3-compatible: AWS, Cloudflare R2, Backblaze B2, or an in-country provider.
# Pin the region to your customers' data residency requirement.
S3_ENDPOINT=
S3_REGION=me-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where uploads go when no object store is configured.
LOCAL_STORAGE_DIR=.storage

# ---------------------------------------------------------------------------
# Billing — without it, the manual invoice flow is the only option
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_AGENCY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
