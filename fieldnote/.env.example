# ---------------------------------------------------------------------------
# Fieldnote environment
#
# Every variable is validated with zod at boot (packages/shared/src/env.ts).
# The app refuses to start on a missing or malformed value rather than failing
# at the first request.
#
# NEXT_PUBLIC_* is the ONLY prefix that reaches the browser bundle. Nothing
# else in this file may be referenced from client components.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public origin of the web app. Used for auth callbacks and delivery links.
APP_URL=http://localhost:3000

# --- Supabase (auth + storage) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret used by the worker to verify Supabase access tokens.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database ---------------------------------------------------------------
# Pooled connection for the web app (PgBouncer, port 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldnote
# Direct connection for migrations and RLS tests (port 5432, no pooler).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldnote

# --- Worker -----------------------------------------------------------------
WORKER_PORT=8080
WORKER_URL=http://localhost:8080
# Shared secret for web -> worker internal calls (job enqueue, requeue).
WORKER_INTERNAL_TOKEN=change-me-in-production
# Concurrency of the in-process job runner.
WORKER_CONCURRENCY=4

# --- ASR: Deepgram ----------------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-GB

# --- LLM: Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Structuring runs once per report section at high volume; the Sonnet tier is
# the cost/quality default. See docs/adr/0004-structuring-model-choice.md.
ANTHROPIC_STRUCTURING_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium

# --- Embeddings (phrase_examples retrieval) ---------------------------------
# openai | voyage
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Email delivery ---------------------------------------------------------
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=reports@yourdomain.com
DELIVERY_FROM_NAME=Fieldnote
# Verifies Resend delivery/open webhooks.
RESEND_WEBHOOK_SECRET=

# --- Billing ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_FOUNDING=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Alert when inference cost per report exceeds this share of ARPU (0.12 = 12%).
INFERENCE_COST_ALERT_RATIO=0.12
LOG_LEVEL=info
